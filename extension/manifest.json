{
  "manifest_version": 3,
  "name": "slothDJ",
  "short_name": "slothDJ",
  "version": "1.0.0",
  "description": "One-click SoundCloud downloads. Sends tracks, sets and profiles to the slothDJ desktop app.",
  "homepage_url": "https://github.com/BaraaJadaan/slothDJ",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "slothDJ",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "https://soundcloud.com/*"],
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*", "https://m.soundcloud.com/*"],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/logo.svg"],
      "matches": ["https://soundcloud.com/*", "https://m.soundcloud.com/*"]
    }
  ]
}
