{
  "manifest_version": 3,
  "name": "SlothDJ",
  "short_name": "SlothDJ",
  "version": "1.3.1",
  "description": "One-click SoundCloud and YouTube downloads. Sends tracks, videos, sets and playlists to the SlothDJ desktop app.",
  "homepage_url": "https://github.com/BaraaJadaan/slothDJ",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SlothDJ",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://soundcloud.com/*",
    "https://m.soundcloud.com/*",
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://soundcloud.com/*",
        "https://m.soundcloud.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/logo.svg"
      ],
      "matches": [
        "https://soundcloud.com/*",
        "https://m.soundcloud.com/*",
        "https://www.youtube.com/*"
      ]
    }
  ]
}
